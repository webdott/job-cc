generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum JobStatus {
  UNSEEN
  SAVED
  APPLIED
  ARCHIVED
}

enum Recommendation {
  APPLY
  SKIP
  MAYBE
}

enum AiProvider {
  GOOGLE
  ANTHROPIC
}

model User {
  id                String             @id @default(cuid())
  clerkId           String             @unique
  email             String             @unique
  name              String?
  preferences       Json               @default("{}")
  pushSubscription  Json?
  // Per-user AI model picks (allowlisted + BYOC). Null → provider defaults.
  aiFlashModel      String?
  aiProModel        String?
  createdAt         DateTime           @default(now())
  resumes           Resume[]
  jobs              Job[]
  applications      Application[]
  evaluations       JobEvaluation[]
  interviewStories  InterviewStory[]
  pushSubscriptions PushSubscription[]
  notifications     Notification[]
  stages            Stage[]
  credentials       UserCredentials?
}

// Encrypted BYOC credentials for non-allowlisted users (see lib/byoc.ts).
// Allowlisted users never have a row here — they use the operator's own
// env-configured Gemini/Anthropic + R2 + Brevo credentials.
model UserCredentials {
  id                   String     @id @default(cuid())
  userId               String     @unique
  user                 User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  aiProvider           AiProvider
  aiApiKeyEnc          String
  r2AccountIdEnc       String
  r2AccessKeyIdEnc     String
  r2SecretAccessKeyEnc String
  r2BucketNameEnc      String
  r2PublicUrlEnc       String
  // Nullable so existing BYOC rows remain valid until the user re-saves.
  brevoApiKeyEnc       String?
  brevoFromEmailEnc    String?
  verifiedAt           DateTime
  createdAt            DateTime   @default(now())
  updatedAt            DateTime   @updatedAt
}

model Resume {
  id               String        @id @default(cuid())
  userId           String
  user             User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  label            String
  fileUrl          String
  isActive         Boolean       @default(false)
  parsedData       Json          @default("{}")
  strengthScore    Int?
  strengthFeedback String?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  coverLetters     CoverLetter[]
  pdfExports       PdfExport[]
}

model Job {
  id          String    @id @default(cuid())
  sourceUrl   String
  sourceId    String?
  title       String
  company     String
  location    String?
  description String
  salaryMin   Int?
  salaryMax   Int?
  remote      Boolean   @default(false)
  postedAt    DateTime?
  fetchedAt   DateTime  @default(now())
  status      JobStatus @default(UNSEEN)

  /// Number of *permanent* scoring failures (bad model output, 4xx). Transient
  /// failures (429/5xx) deliberately do not increment this. A job leaves the
  /// scoring queue at MAX_SCORE_ATTEMPTS so one malformed description can't
  /// block the head of the queue forever. See lib/score-queue.ts.
  scoreAttempts Int     @default(0)
  scoreError    String?

  /// Normalized "company|title", used to collapse the same role appearing on
  /// more than one source under different URLs. Indexed but deliberately NOT
  /// unique: HN titles are parsed heuristically, and a bad parse must not be
  /// able to permanently block a legitimate posting. Null when either side
  /// normalized to nothing. See lib/job-match.ts.
  dedupeKey String?

  /// Whether this job matched the user's targetRoles when it was ingested.
  /// null = never evaluated (ingested before filtering existed) and treated as
  /// eligible. Recomputed when job preferences change, so narrowing or
  /// broadening targetRoles both take effect on unscored jobs.
  prefMatch Boolean?

  /// Why the job was archived: "low_score" | "user". Low scorers keep their row
  /// as a tombstone — deleting would let the next ingest re-insert and re-score
  /// them every night — but their description is blanked to reclaim the space.
  archivedReason String?

  userId       String
  user         User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  evaluation   JobEvaluation?
  applications Application[]
  pdfExports   PdfExport[]

  @@unique([sourceUrl, userId])
  // Drives the scoring queue and the discover list, both of which filter on
  // userId + status + prefMatch and order by fetchedAt.
  @@index([userId, status, prefMatch, fetchedAt])
  @@index([userId, dedupeKey])
}

model JobEvaluation {
  id             String          @id @default(cuid())
  jobId          String          @unique
  job            Job             @relation(fields: [jobId], references: [id], onDelete: Cascade)
  userId         String
  user           User            @relation(fields: [userId], references: [id], onDelete: Cascade)
  archetype      String?
  blockA         Json?
  blockB         Json?
  blockC         Json?
  blockD         Json?
  blockE         Json?
  blockF         Json?
  blockG         Json?
  overallScore   Float?
  recommendation Recommendation?
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
  application    Application?
}

model Application {
  id             String         @id @default(cuid())
  userId         String
  user           User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  jobId          String?
  job            Job?           @relation(fields: [jobId], references: [id])
  inlineJobData  Json?
  stage          String         @default("Saved")
  appliedAt      DateTime?
  lastActivityAt DateTime       @default(now())
  followUpAt     DateTime?
  notes          String?
  contacts       Json[]         @default([])
  timelineEvents Json[]         @default([])
  coverLetter    CoverLetter?
  evaluationId   String?        @unique
  evaluation     JobEvaluation? @relation(fields: [evaluationId], references: [id])
  pdfExports     PdfExport[]
  createdAt      DateTime       @default(now())

  // The reminders cron scans for due follow-ups across all users; without this
  // it is a full table scan.
  @@index([followUpAt, stage])
}

model CoverLetter {
  id            String      @id @default(cuid())
  applicationId String      @unique
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeId      String
  resume        Resume      @relation(fields: [resumeId], references: [id])
  content       String
  tone          String      @default("Professional")
  versions      Json[]      @default([])
  createdAt     DateTime    @default(now())
  updatedAt     DateTime    @updatedAt
}

model InterviewStory {
  id                   String   @id @default(cuid())
  userId               String
  user                 User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title                String
  situation            String
  task                 String
  action               String
  result               String
  reflection           String?
  skills               String[] @default([])
  usedInApplicationIds String[] @default([])
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt
}

model PdfExport {
  id            String      @id @default(cuid())
  applicationId String
  application   Application @relation(fields: [applicationId], references: [id], onDelete: Cascade)
  resumeId      String
  resume        Resume      @relation(fields: [resumeId], references: [id])
  jobId         String?
  job           Job?        @relation(fields: [jobId], references: [id])
  filePath      String
  keywords      String[]    @default([])
  createdAt     DateTime    @default(now())
}

model PushSubscription {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  endpoint  String   @unique
  p256dh    String
  auth      String
  createdAt DateTime @default(now())
}

model Notification {
  id        String    @id @default(cuid())
  userId    String
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type      String
  title     String
  body      String
  url       String?
  readAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([userId, createdAt])
}

// Active/orderable Kanban columns a user can customize. Ghosted/Withdrawn/
// Archived are a separate, fixed set of terminal statuses (see lib/stage-constants.ts)
// and are intentionally not part of this table.
model Stage {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  key       String
  label     String
  color     String   @default("bg-slate-500")
  position  Int
  createdAt DateTime @default(now())

  @@unique([userId, key])
  @@index([userId, position])
}
